{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smartbiblia.fr/contracts/topic-momentum-outcome-v0.1.schema.json",
  "title": "Topic Momentum event outcome 0.1",
  "type": "object",
  "required": [
    "schema_version",
    "outcome_id",
    "signal_id",
    "topic",
    "horizon_months",
    "status",
    "detection",
    "target_cutoff",
    "outcome",
    "provenance"
  ],
  "properties": {
    "schema_version": {"const": "topic-momentum-outcome/0.1"},
    "outcome_id": {"type": "string"},
    "signal_id": {"type": "string"},
    "topic": {
      "type": "object",
      "required": ["id", "label"],
      "properties": {
        "id": {"type": "string"},
        "label": {"type": "string"}
      },
      "additionalProperties": false
    },
    "horizon_months": {"enum": [6, 12]},
    "status": {"enum": ["OBSERVED", "RIGHT_CENSORED"]},
    "detection": {"type": "object"},
    "target_cutoff": {"type": "string", "format": "date"},
    "outcome": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "required": ["label", "confirmed", "target_window", "metrics"],
          "properties": {
            "label": {
              "enum": ["STRENGTHENED", "RETAINED", "FADED", "REVERSED", "MIXED"]
            },
            "confirmed": {"type": "boolean"},
            "target_window": {"type": "object"},
            "metrics": {"type": "object"}
          }
        }
      ]
    },
    "provenance": {"type": "object"}
  },
  "additionalProperties": true
}
